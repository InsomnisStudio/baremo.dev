---
// The landing in the other languages; Spanish is at the root.
import Landing from "../../components/prices/Landing.astro";
import { locales, type Locale } from "../../i18n";

export function getStaticPaths() {
    return locales.filter((lang) => lang !== "es").map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
---

<Landing lang={lang} />
